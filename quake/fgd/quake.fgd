	sounds(choices) : "Sound" : 2 =
	[
		1 : "Base, fast"
		2 : "Chain, slow"
	]
]

@SolidClass base(Appearflags, Targetname) color(0 255 200) = func_train : "A mover that follows a chain of path_corners once fired."
