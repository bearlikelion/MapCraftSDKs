// Triggers

@SolidClass base(Trigger) color(200 120 255) = trigger_multiple : "Fires its targets every time it is touched, with a pause between."
[
	spawnflags(flags) =
	[
		1 : "Not touchable" : 0 : "Only fires when it is itself fired."
		256 : "Not on Easy" : 0
		512 : "Not on Normal" : 0
		1024 : "Not on Hard" : 0
		2048 : "Not in Deathmatch" : 0
	]
	wait(float) : "Wait" : "0.2" : "Seconds before it can fire again."
]

@SolidClass base(Trigger) color(200 120 255) = trigger_once : "Fires its targets the first time it is touched, then goes away."
[
	spawnflags(flags) =
	[
		1 : "Not touchable" : 0 : "Only fires when it is itself fired."
		256 : "Not on Easy" : 0
		512 : "Not on Normal" : 0
		1024 : "Not on Hard" : 0
		2048 : "Not in Deathmatch" : 0
