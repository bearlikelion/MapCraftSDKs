// Quake (id1) entities for MapCraft, written for this SDK.
// Entity names, keys and flag bits follow the game; the descriptions are original.

@SolidClass = worldspawn : "The level itself."
[
	message(string) : "Level name" : : "Shown when the level starts."
	worldtype(choices) : "Theme" : 0 : "Picks the look of keys and some sounds." =
	[
		0 : "Medieval"
		1 : "Metal (runic)"
		2 : "Base"
	]
	sounds(integer) : "CD track" : 0
	wad(string) : "Texture WADs" : : "WAD files the compiler reads textures from, separated by semicolons."
]

// Base classes. A class's own spawnflags replace those it inherits, so classes with flags of their own repeat the difficulty flags.

@BaseClass = Appearflags
[
	spawnflags(flags) =
	[
		256 : "Not on Easy" : 0
		512 : "Not on Normal" : 0
		1024 : "Not on Hard" : 0
		2048 : "Not in Deathmatch" : 0
	]
]

@BaseClass = Targetname
[
	targetname(target_source) : "Name" : : "What triggers and buttons call this entity."
]

@BaseClass = Target
[
	target(target_destination) : "Target" : : "Entities to fire."
	killtarget(target_destination) : "Kill target" : : "Entities to remove."
]

@BaseClass base(Target) = Fires
[
	delay(float) : "Delay" : "0" : "Seconds to wait before firing the targets."
	message(string) : "Message" : : "Text printed to whoever set it off."
]

@BaseClass = Facing
[
	angle(integer) : "Facing" : 0 : "Yaw in degrees."
]

@BaseClass = Mover
[
	angle(integer) : "Direction" : 0 : "Yaw in degrees it moves along; -1 is up and -2 is down."
]

@BaseClass base(Appearflags, Facing, Targetname, Target) color(220 0 0) = Monster
[
	spawnflags(flags) =
	[
		1 : "Ambush" : 0 : "Waits until it sees the player instead of waking to noise."
		256 : "Not on Easy" : 0
		512 : "Not on Normal" : 0
		1024 : "Not on Hard" : 0
		2048 : "Not in Deathmatch" : 0
	]
]

@BaseClass base(Appearflags, Target) = Item []

@BaseClass base(Item) color(0 80 255) size(-16 -16 0, 16 16 32) = Weapon []

@BaseClass base(Item) color(80 160 255) size(0 0 0, 32 32 32) = Ammo
[
	spawnflags(flags) =
	[
		1 : "Large box" : 0
		256 : "Not on Easy" : 0
		512 : "Not on Normal" : 0
		1024 : "Not on Hard" : 0
		2048 : "Not in Deathmatch" : 0
	]
]

@BaseClass base(Targetname) color(255 255 40) size(-8 -8 -8, 8 8 8) = Lighting
[
	spawnflags(flags) =
	[
		1 : "Start off" : 0 : "Only meaningful with a name; firing it toggles the light."
	]
	light(integer) : "Brightness" : 300
	_color(color255) : "Color" : "255 255 255" : "Read by the light compiler."
	style(choices) : "Style" : 0 : "How the light animates in game." =
	[
		0 : "Steady"
		1 : "Flicker 1"
		2 : "Slow strong pulse"
		3 : "Candle 1"
		4 : "Fast strobe"
		5 : "Gentle pulse"
		6 : "Flicker 2"
		7 : "Candle 2"
		8 : "Candle 3"
		9 : "Slow strobe"
		10 : "Fluorescent flicker"
		11 : "Slow pulse, never dark"
	]
	wait(float) : "Fade scale" : "1" : "Larger values make the light reach less far."
	delay(choices) : "Falloff" : 0 : "Read by the light compiler." =
	[
		0 : "Linear"
		1 : "Inverse distance"
		2 : "Inverse square"
		3 : "None"
	]
	target(target_destination) : "Aim at" : : "An info_null to point a spotlight at."
	mangle(string) : "Spotlight direction" : : "Yaw, pitch and roll; makes the light a spotlight."
]

@BaseClass base(Appearflags, Targetname, Fires) = Trigger
[
	sounds(choices) : "Sound" : 0 =
	[
		0 : "None"
		1 : "Secret"
		2 : "Beeps"
		3 : "Large switch"
	]
	health(integer) : "Health" : 0 : "When set, it must be shot instead of touched."
	angle(integer) : "Entry direction" : 0 : "When set, it only fires for someone moving this way."
]

// Player starts and markers

@PointClass base(Facing) color(0 255 0) size(-16 -16 -24, 16 16 32) = info_player_start : "Where a single player game begins."
[]

@PointClass base(Facing) color(0 200 0) size(-16 -16 -24, 16 16 32) = info_player_start2 : "Where the player begins on the start map after finishing an episode."
[]

@PointClass base(Facing) color(255 120 0) size(-16 -16 -24, 16 16 32) = info_player_deathmatch : "A deathmatch spawn point."
[]

@PointClass base(Facing) color(0 160 255) size(-16 -16 -24, 16 16 32) = info_player_coop : "A cooperative play spawn point."
[]

@PointClass color(255 80 255) size(-16 -16 -16, 16 16 16) = info_intermission : "A camera for the end of level scoreboard; one is picked at random."
[
	mangle(string) : "View angles" : "0 0 0" : "Pitch, yaw and roll."
]

@PointClass base(Facing, Targetname) color(200 0 255) size(-8 -8 -8, 8 8 32) = info_teleport_destination : "Where a trigger_teleport sends whoever enters it."
[]

@PointClass base(Targetname) color(160 160 160) size(-4 -4 -4, 4 4 4) = info_null : "A position for other entities to aim at; removed when the level starts."
[]

@PointClass base(Targetname) color(160 160 160) size(-4 -4 -4, 4 4 4) = info_notnull : "Like info_null, but it stays in the level."
[]

@PointClass base(Targetname) color(80 255 255) size(-8 -8 -8, 8 8 8) = path_corner : "A stop on the route of a func_train or a patrolling monster."
[
	target(target_destination) : "Next stop"
	wait(float) : "Wait" : "0" : "Seconds to pause here; -1 stops for good."
]

// Lights

@PointClass base(Lighting) = light : "An invisible light."
[]

@PointClass base(Lighting) = light_fluoro : "A light that hums like a fluorescent tube."
[]

@PointClass base(Lighting) = light_fluorospark : "A buzzing light that flickers and sparks."
[]

@PointClass base(Lighting) = light_globe : "A small glowing ball."
[]

@PointClass base(Lighting) = light_torch_small_walltorch : "A torch for walls."
[]

@PointClass base(Lighting) = light_flame_large_yellow : "A large burning flame."
[]

@PointClass base(Lighting) = light_flame_small_yellow : "A small yellow flame."
[]

@PointClass base(Lighting) = light_flame_small_white : "A small white flame."
[]

// Brush entities

@SolidClass base(Appearflags, Targetname, Fires, Mover) color(0 200 255) = func_door : "A sliding door; doors that touch open together."
[
	spawnflags(flags) =
	[
		1 : "Starts open" : 0
		4 : "Don't link" : 0 : "Opens alone even when touching other doors."
		8 : "Gold key" : 0
		16 : "Silver key" : 0
		32 : "Toggle" : 0 : "Stays put until fired again."
		256 : "Not on Easy" : 0
		512 : "Not on Normal" : 0
		1024 : "Not on Hard" : 0
		2048 : "Not in Deathmatch" : 0
	]
	speed(integer) : "Speed" : 100
	wait(float) : "Wait" : "3" : "Seconds before it closes; -1 keeps it open."
	lip(integer) : "Lip" : 8 : "How much of it stays in view when open."
	dmg(integer) : "Crush damage" : 2
	health(integer) : "Health" : 0 : "When set, it opens when shot."
	sounds(choices) : "Sound" : 0 =
	[
		0 : "None"
		1 : "Stone"
		2 : "Machine"
		3 : "Stone chain"
		4 : "Screeching metal"
	]
]

@SolidClass base(Appearflags, Targetname, Fires, Mover) color(0 160 220) = func_door_secret : "A secret door that moves back, then sideways."
[
	spawnflags(flags) =
	[
		1 : "Open once" : 0 : "Stays open."
		2 : "Left first" : 0 : "Moves left before backing away."
		4 : "Down first" : 0 : "Moves down before backing away."
		8 : "Not shootable" : 0 : "Only opens when fired."
		16 : "Always shootable" : 0 : "Can be shot even when it has a name."
		256 : "Not on Easy" : 0
		512 : "Not on Normal" : 0
		1024 : "Not on Hard" : 0
		2048 : "Not in Deathmatch" : 0
	]
	t_width(integer) : "Side distance" : 0 : "How far it moves sideways; its own width when 0."
	t_length(integer) : "Back distance" : 0 : "How far it moves back; its own depth when 0."
	wait(float) : "Wait" : "5" : "Seconds before it closes."
	dmg(integer) : "Crush damage" : 2
	sounds(choices) : "Sound" : 3 =
	[
		1 : "Medieval"
		2 : "Metal"
		3 : "Base"
	]
]

@SolidClass base(Appearflags, Targetname, Fires, Mover) color(255 160 0) = func_button : "A button pressed by touching or shooting it."
[
	speed(integer) : "Speed" : 40
	lip(integer) : "Lip" : 4 : "How much of it stays in view when pressed."
	wait(float) : "Wait" : "1" : "Seconds before it pops out; -1 keeps it pressed."
	health(integer) : "Health" : 0 : "When set, it must be shot."
	sounds(choices) : "Sound" : 0 =
	[
		0 : "Steam metal"
		1 : "Wooden clunk"
		2 : "Metal click"
		3 : "In and out"
	]
]

@SolidClass base(Appearflags, Targetname) color(0 255 160) = func_plat : "A lift that rises when stood on and lowers once left."
[
	spawnflags(flags) =
	[
		1 : "Low trigger" : 0 : "Only the bottom of its travel triggers it."
		256 : "Not on Easy" : 0
		512 : "Not on Normal" : 0
		1024 : "Not on Hard" : 0
		2048 : "Not in Deathmatch" : 0
